DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Kampala

# Development defaults to SQLite if DATABASE_URL is unset.
# Production example:
# DATABASE_URL=postgresql://mailforge:strong-password@127.0.0.1:5432/mailforge
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0

MAIL_BACKEND=stalwart
STALWART_BASE_URL=https://mail.example.com
STALWART_API_TOKEN=replace-me
STALWART_VERIFY_TLS=1

# Public SMTP identity used by DNS readiness checks.
# Production example: mail.your-mailforge-domain.com and the VPS public IPv4.
MAILFORGE_MAIL_HOSTNAME=
MAILFORGE_MAIL_IPV4=

# Re-check provisioned domains and synchronize Stalwart emailSend permissions.
MAILFORGE_DNS_RECONCILE_MINUTES=15

# Webmail uses Stalwart's OAuth Authorization Code flow with PKCE.
# Pre-register this client in production and add your exact callback URL.
MAILFORGE_OAUTH_CLIENT_ID=mailforge-webmail
MAILFORGE_OAUTH_CLIENT_SECRET=
MAILFORGE_OAUTH_SCOPE=

# Webmail attachment guardrails. Stalwart has its own upload/message limits too.
MAILFORGE_MAX_ATTACHMENT_MB=20
MAILFORGE_MAX_TOTAL_ATTACHMENT_MB=25

MAILFORGE_DEFAULT_MAX_MAILBOXES=25
MAILFORGE_DEFAULT_DOMAIN_QUOTA_MB=102400
MAILFORGE_DEFAULT_MAILBOX_QUOTA_MB=5120
MAILFORGE_MAX_MAILBOX_QUOTA_MB=51200
MAILFORGE_MAX_ALIAS_RECIPIENTS=20

DEFAULT_FROM_EMAIL=noreply@example.com
